+static int ax88179a_autodetach(struct ax_device *axdev)
+{
+	u16 value = ((axdev->autodetach) ? 1 : 0) | AX88179A_AUTODETACH_DELAY;
+
+	return ax_write_cmd(axdev, AX88179A_AUTODETACH, value, 0, 0, NULL);
+}
