+			*temp++ = macsec_dbg_count[i];
+		macsec_dbg_count = (u32 *)&axdev->macsec_cfg->tx_dbg_count;
+		for (i = 0; i < (AX_MACSEC_TX_DBG_CNT_SIZE / sizeof(u32)); i++)
+			*temp++ = macsec_dbg_count[i];
