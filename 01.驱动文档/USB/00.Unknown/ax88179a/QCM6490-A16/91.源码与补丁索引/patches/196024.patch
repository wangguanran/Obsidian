+
+		ret = __asix_read_cmd(dev, cmd, value, index, size, &buf, 0);
+		le32_to_cpus(&buf);
+		*((u32 *)data) = buf;
+	} else {
+		ret = __asix_read_cmd(dev, cmd, value, index, size, data, 0);
