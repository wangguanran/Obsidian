 #include "dp_link.h"
 #include "sde_edid_parser.h"
 #include "sde_connector.h"
+#include <drm/drm_panel.h>
 #include "msm_drv.h"
 
 #define DP_RECEIVER_DSC_CAP_SIZE    15
@@ -157,6 +158,11 @@
 
 	u32 dsc_blks_in_use;
 	u32 max_lm;
+	/* For eDP panel_event_notifier (A14 panel-notifier-support path) */
+	struct drm_panel drm_panel;
+	struct device panel_dev;
+	bool drm_panel_registered;
+
 	/* DRM connector assosiated with this panel */
 	struct drm_connector *connector;
 
diff --git a/msm/dp/dp_parser.c b/msm/dp/dp_parser.c
index 8abcae6..f1f50b4 100644
--- a/msm/dp/dp_parser.c
+++ b/msm/dp/dp_parser.c
@@ -179,6 +179,9 @@
 	if (!parser->display_type)
 		parser->display_type = "unknown";
 
+	parser->panel_notifier_support = of_property_read_bool(of_node,
+			"qcom,panel-notifier-support");
+	DP_DEBUG("panel-notifier-support = %d\n", parser->panel_notifier_support);
 
 	parser->no_backlight_support = of_property_read_bool(of_node,
 			"qcom,no-backlight-support");
