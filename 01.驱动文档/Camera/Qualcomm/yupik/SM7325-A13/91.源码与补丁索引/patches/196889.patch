+// IFENode::ProcessingNodeFenceCallback
+////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+VOID IFENode::ProcessingNodeFenceCallback(
+    NodeFenceHandlerData* pFenceHandlerData,
+    UINT64                requestId,
+    UINT                  portId)
+{
+    CAMX_UNREFERENCED_PARAM(pFenceHandlerData);
+
+    if ((IFEOutputPortRDI0 > portId) || (IFEOutputPortRDI3 < portId))
+    {
+        return;
+    }
+    if ((FALSE == m_isYUVSensor) ||
+        (NULL == m_pSensorCaps) ||
+        (NULL == m_pSensorModeData) ||
+        (1 >= m_pSensorModeData->streamConfigCount))
+    {
+        return;
+    }
+
+    const INT nvpChip = Nvp6188ChipFromSensorName(m_pSensorCaps->pSensorName);
+    if (0 > nvpChip)
+    {
+        return;
+    }
+
+    const UINT vc = portId - IFEOutputPortRDI0;
+    Nvp6188NoteRdiFence(static_cast<UINT>(nvpChip), vc, requestId);
+}
