+// Bank0 0xa8 video-loss on this NVP6188 board (field evidence):
+//   all cams locked → 0xa8==0x00; CH2 unplug → 0xa8==0x04 (bit2 set).
+// Polarity: bit=1 means lost  →  is_lost = (reg >> ch) & 1
+// (NVP6158 inverted ~reg polarity is WRONG here — caused all-colorbar §48.)
+static BOOL NvpReadVideoLossReg(
+    INT    fd,
+    UINT8* pReg)
+{
+    if ((NULL == pReg) || (FALSE == NvpReadBank(fd, 0x00, 0xa8, pReg)))
+    {
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL NvpChVideoLost(
+    UINT8 vlossReg,
+    UINT  ch)
+{
+    if (ch >= NvpMaxCh)
+    {
+        return FALSE;
+    }
+    return (((static_cast<UINT>(vlossReg) >> ch) & 0x1u) != 0) ? TRUE : FALSE;
+}
+
+// Per-CH virtual pattern on unlock (bank0 0x78/0x79). Keeps MIPI SOF/BUF_DONE for
+// missing lanes so FourStream siblings stay alive. Product default ON; set
+// persist.vendor.camera.nvp6188.pattern_on_unlock=0 to disable. No set_chn / no MAR.
+static BOOL NvpPatternOnUnlockEnabled()
+{
+    CHAR val[PROP_VALUE_MAX] = { 0 };
+    if (__system_property_get("persist.vendor.camera.nvp6188.pattern_on_unlock", val) <= 0)
+    {
+        return TRUE;
+    }
+    // Explicit off only.
+    return !(('0' == val[0]) || ('n' == val[0]) || ('N' == val[0]) || ('f' == val[0]));
+}
+
+static VOID NvpKickAutoDetect(
+    INT fd)
+{
+    // bank13 — wake AHD format detect. Call only under peer shield (unlocked peer).
+    NvpWriteBank(fd, 0x13, 0x30, 0x7f);
+    NvpWriteBank(fd, 0x13, 0x31, 0xff);
+    NvpWriteBank(fd, 0x13, 0x70, 0x3f);
+}
+
+static VOID NvpSyncVirtualPattern(
+    INT   fd,
+    UINT  chipId,
+    UINT8 vlossMaskExtra)
+{
+    static BOOL   s_patternOn[NvpChipMax]     = { FALSE, FALSE };
+    static UINT8  s_patternMask[NvpChipMax]   = { 0, 0 };
+    static UINT64 s_patternLastMs[NvpChipMax] = { 0, 0 };
+
+    if ((fd < 0) || (FALSE == NvpChipValid(chipId)) ||
+        (FALSE == NvpPatternOnUnlockEnabled()))
+    {
+        return;
+    }
+
+    // Pattern bits (§74):
+    //  - unlocked CHs
+    //  - optional sole-keepalive bit in vlossMaskExtra (caller passes 0 or ONE bit only)
+    UINT8 mask = 0;
+    pthread_mutex_lock(&g_nvpLock);
+    for (UINT ch = 0; ch < NvpMaxCh; ch++)
+    {
+        if ((TRUE == g_nvp[chipId].unlocked[ch]) ||
+            (TRUE == g_nvpKeepPattern[chipId][ch]))
+        {
+            mask = static_cast<UINT8>(mask | static_cast<UINT8>(1U << ch));
+        }
+    }
+    pthread_mutex_unlock(&g_nvpLock);
+    // Sole-a8 SOF keepalive only — never raw multi-a8 couple mask.
+    mask = static_cast<UINT8>(mask | (vlossMaskExtra & 0x0f));
+
+    const BOOL anyPattern = (0 != mask);
+
+    // §70: rewrite ONLY when mask changes or HW dropped 0x78 (mismatch).
+    // §69 always-rewrite (~10Hz) thrashed MIPI → boot with 3 cams: DRQ stuck / no display.
+    UINT8 hw78 = 0;
+    const BOOL hwOk = NvpReadBank(fd, 0x00, 0x78, &hw78);
+    const UINT64 nowMs = NvpNowMs();
+
+    if (FALSE == anyPattern)
+    {
+        if ((FALSE == s_patternOn[chipId]) && (0 == s_patternMask[chipId]))
+        {
+            return;
+        }
+        if ((TRUE == NvpWriteBank(fd, 0x00, 0x78, 0x00)) &&
+            (TRUE == NvpWriteBank(fd, 0x00, 0x79, 0x11)))
+        {
+            s_patternOn[chipId]     = FALSE;
+            s_patternMask[chipId]   = 0;
+            s_patternLastMs[chipId] = nowMs;
+            CAMX_LOG_ERROR(CamxLogGroupISP,
+                           "%s: pattern OFF (0x78/0x79=0x00/0x11) — all locked",
+                           NvpTag[chipId]);
+            NVP_ALOG("pattern OFF");
+        }
+        return;
+    }
+
+    const BOOL hwMismatch =
+        (FALSE == hwOk) || (hw78 != mask) || (FALSE == s_patternOn[chipId]) ||
+        (mask != s_patternMask[chipId]);
+    if (FALSE == hwMismatch)
+    {
+        return; // stable — do not spam I2C
+    }
+
+    // §75: only extend sibling hold on mask *change* (not every HW rewrite of same mask).
+    // Rewriting 0x78 every poll when HW drops was refreshing sibHold → settle stuck →
+    // siblings frozen for whole unplug (looked like long 卡顿).
+    const BOOL maskChanged =
+        (FALSE == s_patternOn[chipId]) || (mask != s_patternMask[chipId]);
+
+    // §86: 0x79 MUST stay 0x11 (live/init). Writing 0x79=mask turned on a
+    // global pattern mode → CH1 (1080) flashed colorbar whenever CH2/CH3
+    // pattern-on for SOF (exactly when EPOCH stuttered).
+    if ((TRUE == NvpWriteBank(fd, 0x00, 0x78, mask)) &&
+        (TRUE == NvpWriteBank(fd, 0x00, 0x79, 0x11)))
+    {
+        s_patternOn[chipId]     = TRUE;
+        s_patternMask[chipId]   = mask;
+        s_patternLastMs[chipId] = nowMs;
+        if (TRUE == maskChanged)
+        {
+            g_nvpSiblingHoldUntilMs[chipId] =
+                nowMs + static_cast<UINT64>(NvpSiblingHoldMs);
+            g_nvpPeerShieldUntilMs[chipId] =
+                nowMs + static_cast<UINT64>(NvpPeerShieldExtraMs);
+        }
+        CAMX_LOG_ERROR(CamxLogGroupISP,
+                       "%s: pattern ON (0x78=0x%02x 0x79=0x11) hwWas=0x%02x extra=0x%02x "
+                       "maskChg=%d sibHold=%ums",
+                       NvpTag[chipId], mask, hw78, vlossMaskExtra,
+                       maskChanged, NvpSiblingHoldMs);
+        NVP_ALOG("pattern ON 0x78=0x%02x extra=0x%02x", mask, vlossMaskExtra);
+    }
+}
