+// §104: unlock analog CHs only on a single-CH SOF hole.
+// a8 couples onto the lowest live CH (~5s lag) → sibling 闪蓝. 720 lastDone
+// stays "fresh" while 1080 DMA lags tens of ms — relative freshness is wrong.
+// EPOCH (all analog dead) → 0x78 keepalive, no unlock.
+// Call without g_nvpLock held.
+static VOID NvpApplySofHole(
+    INT  fd,
+    UINT chipId,
+    UINT count)
+{
+    if ((fd < 0) || (FALSE == NvpChipValid(chipId)) || (count > NvpMaxCh))
+    {
+        return;
+    }
+    if (NvpNowMs() < g_nvpPollGraceUntilMs[chipId])
+    {
+        return;
+    }
+
+    const UINT64 nowMs = NvpNowMs();
+    const BOOL inShield =
+        (nowMs < g_nvpPeerShieldUntilMs[chipId]) ||
+        (nowMs < g_nvpSiblingHoldUntilMs[chipId]);
+
+    UINT deadMask = 0;
+    UINT liveMask = 0;
+    pthread_mutex_lock(&g_nvpLock);
+    for (UINT ch = 0; ch < count; ch++)
+    {
+        if ((TRUE == g_nvp[chipId].unlocked[ch]) ||
+            (FALSE == g_nvpEverAnalog[chipId][ch]) ||
+            (0 == g_nvpRdiLastDoneMs[chipId][ch]))
+        {
+            g_nvpHoleStreak[chipId][ch] = 0;
+            continue;
+        }
+        const UINT64 t   = g_nvpRdiLastDoneMs[chipId][ch];
+        const UINT64 age = (nowMs >= t) ? (nowMs - t) : 0;
+        if (age <= static_cast<UINT64>(NvpSofHoleLiveMs))
+        {
+            liveMask |= (1u << ch);
+            g_nvpHoleStreak[chipId][ch] = 0;
+        }
+        else if (age >= static_cast<UINT64>(NvpSofHoleDeadMs))
+        {
+            deadMask |= (1u << ch);
+        }
+    }
+
+    const UINT deadN = static_cast<UINT>(__builtin_popcount(deadMask));
+    const UINT liveN = static_cast<UINT>(__builtin_popcount(liveMask));
+    BOOL needPat = FALSE;
+    BOOL needPub = FALSE;
+
+    if ((1U == deadN) && (liveN >= 1U))
+    {
+        for (UINT ch = 0; ch < count; ch++)
+        {
+            if (0 == (deadMask & (1u << ch)))
+            {
+                continue;
+            }
+            // Keep MIPI SOF immediately so siblings do not EPOCH.
+            g_nvpKeepPattern[chipId][ch] = TRUE;
+            needPat = TRUE;
+            if (TRUE == inShield)
+            {
+                continue;
+            }
+            g_nvpHoleStreak[chipId][ch]++;
+            if (g_nvpHoleStreak[chipId][ch] >= NvpSofHoleNeed)
+            {
+                g_nvp[chipId].unlocked[ch]          = TRUE;
+                g_nvp[chipId].unlockStreak[ch]      = 0;
+                g_nvp[chipId].relockStreak[ch]      = 0;
+                g_nvp[chipId].relockHoldUntilMs[ch] = 0;
+                g_nvp[chipId].lastVfc[ch]           = 0xff;
+                g_nvpHoleStreak[chipId][ch]         = 0;
+                needPub = TRUE;
+                CAMX_LOG_ERROR(CamxLogGroupISP,
+                               "nvp6188: sof-hole unlock ch%u (single analog dead, "
+                               "siblings live) — lock=0 + 0x78",
+                               ch);
+                NVP_ALOG("sof-hole unlock ch%u", ch);
+            }
+        }
+    }
+    else if (deadN >= 2U)
+    {
+        for (UINT ch = 0; ch < count; ch++)
+        {
+            if (0 != (deadMask & (1u << ch)))
+            {
+                g_nvpKeepPattern[chipId][ch] = TRUE;
+                needPat = TRUE;
+            }
+            g_nvpHoleStreak[chipId][ch] = 0;
+        }
+    }
+    else
+    {
+        for (UINT ch = 0; ch < count; ch++)
+        {
+            g_nvpHoleStreak[chipId][ch] = 0;
+        }
+    }
+    pthread_mutex_unlock(&g_nvpLock);
+
+    if (TRUE == needPat)
+    {
+        NvpSyncVirtualPattern(fd, chipId, 0);
+    }
+    if (TRUE == needPub)
+    {
+        Nvp6188PublishActiveSizes(chipId);
+    }
+}
