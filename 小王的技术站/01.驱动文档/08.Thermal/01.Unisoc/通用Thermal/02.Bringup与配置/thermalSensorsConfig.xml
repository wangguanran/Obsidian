			<temp>50000</temp>
			<trip id="0">
				<action name="powerback" arg="AT+SPTPPB=4" file="" />
			</trip>
		</zone_level>
	</sensor>
</ThermalConfig>
                                                                                                                                                                                                                                                                                                                                                                                                                          