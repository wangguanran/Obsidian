		<AvgPeriod>30000</AvgPeriod>
		<zone_level id="0" type="active">
			<temp>40000</temp>
			<trip id="0">
			    <action name="charge" arg="0" file="/sys/class/power_supply/battery/chg_cool_state" />
			</trip>
			<trip id="1">
			    <action name="charge_cur" arg="500" file="/sys/class/power_supply/battery/adjust_cur_min" />
			    <action name="charge" arg="1" file="/sys/class/power_supply/battery/chg_cool_state" />
			</trip>
		</zone_level>
		<zone_level id="1" type="hot">
			<temp>50000</temp>
			<trip id="0">
			    <action name="charge_cur" arg="300" file="/sys/class/power_supply/battery/adjust_cur_min" />
			    <action name="charge" arg="1" file="/sys/class/power_supply/battery/chg_cool_state" />
			</trip>
		</zone_level>
		<zone_level id="2" type="critical">
			<temp>110000</temp>
			<trip id="0">
				<action name="shutdown" arg="" file=""/>
			</trip>
		</zone_level>
	</sensor>
    <sensor>
