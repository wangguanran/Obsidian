        <polling_delay>2000</polling_delay>
        <AvgPeriod>30000</AvgPeriod>
        <zone_level id="0" type="active">
            <temp>40000</temp>
            <trip id="0">
                <action name="min_core" arg="4" file="/sys/class/thermal/cooling_device0/min_core_num" />
                <action name="min_freq" arg="768000" file="/sys/class/thermal/cooling_device0/min_freq" />
                <action name="cpu_scaling_max_freq" arg="1300000" file="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq" />
                <action name="gpu_max_freq" arg="680000000" file="/sys/class/devfreq/60000000.gpu/max_freq" />
            </trip>
            <trip id="1">
                <action name="min_core" arg="3" file="/sys/class/thermal/cooling_device0/min_core_num" />
                <action name="cpu_scaling_max_freq" arg="768000" file="/sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq" />
                <action name="gpu_max_freq" arg="512000000" file="/sys/class/devfreq/60000000.gpu/max_freq" />
            </trip>
        </zone_level>
        <zone_level id="1" type="hot">
            <temp>50000</temp>
            <trip id="0">
                <action name="min_core" arg="2" file="/sys/class/thermal/cooling_device0/min_core_num" />
                <action name="gpu_max_freq" arg="256000000" file="/sys/class/devfreq/60000000.gpu/max_freq" />
            </trip>
        </zone_level>
        <zone_level id="2" type="hot">
            <temp>100000</temp>
            <trip id="0">
                <action name="min_core" arg="1" file="/sys/class/thermal/cooling_device0/min_core_num" />
