+#ifndef _I2C_DRV_H_
+#define _I2C_DRV_H_
+
+#include <linux/i2c.h>
+
+/* kept same as dts */
+#define NFC_I2C_DRV_STR			"qcom,sn-nci"
+#define NFC_I2C_M_DRV_STR		"nxp,nxpnfc_m"
