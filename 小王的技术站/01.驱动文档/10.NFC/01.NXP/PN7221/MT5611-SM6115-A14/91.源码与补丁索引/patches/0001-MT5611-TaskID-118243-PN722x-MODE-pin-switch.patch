diff --git a/vendor/qcom/proprietary/nfc-devicetree/nxp/bengal-nfc-pinctrl-mt5611.dtsi b/vendor/qcom/proprietary/nfc-devicetree/nxp/bengal-nfc-pinctrl-mt5611.dtsi
