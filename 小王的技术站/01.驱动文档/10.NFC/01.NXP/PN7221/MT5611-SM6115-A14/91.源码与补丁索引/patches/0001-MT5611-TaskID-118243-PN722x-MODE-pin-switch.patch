 void gpio_set_ven(struct nfc_dev *nfc_dev, int value);
+void set_valid_gpio(int gpio, int value);
 void gpio_free_all(struct nfc_dev *nfc_dev);
 int validate_nfc_state_nci(struct nfc_dev *nfc_dev);
 int get_valid_gpio(int gpio);
diff --git a/kernel_platform/msm-kernel/drivers/nfc/pn7220/i2c_drv.c b/kernel_platform/msm-kernel/drivers/nfc/pn7220/i2c_drv.c
