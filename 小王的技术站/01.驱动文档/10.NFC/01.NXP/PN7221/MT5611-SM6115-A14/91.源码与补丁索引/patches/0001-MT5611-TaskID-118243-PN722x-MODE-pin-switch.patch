+/* Forward declaration for sysfs attribute used in register/unregister paths. */
+static ssize_t nfc_mode_show(struct device *dev,
+			       struct device_attribute *attr, char *buf);
+static ssize_t nfc_mode_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count);
+static DEVICE_ATTR(nfc_mode, 0660, nfc_mode_show, nfc_mode_store);
+
 void nfc_misc_unregister(struct nfc_dev *nfc_dev, int count)
 {
 	pr_debug("%s: entry\n", __func__);
+	device_remove_file(nfc_dev->nfc_device, &dev_attr_nfc_mode);
 	device_destroy(nfc_dev->nfc_class, nfc_dev->devno);
 	cdev_del(&nfc_dev->c_dev);
 	class_destroy(nfc_dev->nfc_class);
@@ -244,6 +244,16 @@ int nfc_misc_register(struct nfc_dev *nfc_dev,
 		unregister_chrdev_region(nfc_dev->devno, count);
 		return ret;
 	}
+	ret = device_create_file(nfc_dev->nfc_device, &dev_attr_nfc_mode);
+	if (ret) {
+		pr_err("%s: failed to create nfc_mode attr ret %d\n",
+		       __func__, ret);
+		device_destroy(nfc_dev->nfc_class, nfc_dev->devno);
+		cdev_del(&nfc_dev->c_dev);
+		class_destroy(nfc_dev->nfc_class);
+		unregister_chrdev_region(nfc_dev->devno, count);
+		return ret;
+	}
 	return 0;
 }
 
@@ -267,12 +277,17 @@ static int led_switch_control_ioctl(struct nfc_dev *nfc_dev, unsigned long arg)
 static int mode_switch_nfcc_ioctl(struct nfc_dev *nfc_dev, unsigned long arg)
 {
 	int ret = 0;
-	//struct platform_gpio *nfc_gpio = &nfc_dev->configs.gpio;
+	struct platform_gpio *nfc_gpio = &nfc_dev->configs.gpio;
+
+	if (!gpio_is_valid(nfc_gpio->mode_sw_nfcc)) {
+		pr_err("%s: mode_sw gpio invalid\n", __func__);
+		return -ENODEV;
+	}
 
 	if (arg == NCI_MODE) {
-		//set_valid_gpio(nfc_gpio->mode_sw_nfcc, 0);
+		set_valid_gpio(nfc_gpio->mode_sw_nfcc, 0);
 	} else if (arg == EMVCO_MODE) {
-		//set_valid_gpio(nfc_gpio->mode_sw_nfcc, 1);
+		set_valid_gpio(nfc_gpio->mode_sw_nfcc, 1);
 	} else {
 		pr_err("%s: bad arg %lu\n", __func__, arg);
 		ret = -ENOIOCTLCMD;
@@ -280,6 +295,54 @@ static int mode_switch_nfcc_ioctl(struct nfc_dev *nfc_dev, unsigned long arg)
 	return ret;
 }
 
+static ssize_t nfc_mode_show(struct device *dev,
+			       struct device_attribute *attr, char *buf)
+{
+	struct nfc_dev *nfc_dev = dev_get_drvdata(dev);
+	struct platform_gpio *nfc_gpio;
+	int value;
+
+	if (!nfc_dev)
+		return -ENODEV;
+
+	nfc_gpio = &nfc_dev->configs.gpio;
+	if (!gpio_is_valid(nfc_gpio->mode_sw_nfcc))
+		return -ENODEV;
+
+	value = get_valid_gpio(nfc_gpio->mode_sw_nfcc);
+	if (value < 0)
+		return value;
+
+	return scnprintf(buf, PAGE_SIZE, "%d\n", value);
+}
+
+static ssize_t nfc_mode_store(struct device *dev,
+				struct device_attribute *attr,
+				const char *buf, size_t count)
+{
+	struct nfc_dev *nfc_dev = dev_get_drvdata(dev);
+	struct platform_gpio *nfc_gpio;
+	int value;
+
+	if (!nfc_dev)
+		return -ENODEV;
+
+	nfc_gpio = &nfc_dev->configs.gpio;
+	if (!gpio_is_valid(nfc_gpio->mode_sw_nfcc))
+		return -ENODEV;
+
+	if (kstrtoint(buf, 0, &value))
+		return -EINVAL;
+	if (value != 0 && value != 1)
+		return -EINVAL;
+
+	set_valid_gpio(nfc_gpio->mode_sw_nfcc, value);
+	pr_info("%s: MODE gpio set to %d (%s)\n", __func__, value,
+		value ? "EMVCo" : "NFC Forum");
+
+	return count;
+}
+
 /**
  * nfc_ioctl_power_states() - power control
  * @nfc_dev:    nfc device data structure
diff --git a/kernel_platform/msm-kernel/drivers/nfc/pn7220/common.h b/kernel_platform/msm-kernel/drivers/nfc/pn7220/common.h
