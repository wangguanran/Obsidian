+++ b/kernel_platform/msm-kernel/drivers/nfc/pn7220/i2c_drv.c
@@ -312,6 +312,9 @@ int nfc_i2c_dev_probe(struct i2c_client *client, const struct i2c_device_id *id)
 	nfc_dev->nfc_write = i2c_write;
 	nfc_dev->nfc_enable_intr = i2c_enable_irq;
 	nfc_dev->nfc_disable_intr = i2c_disable_irq;
+	/* copy gpio details before configure so error path can free */
+	memcpy(&nfc_dev->configs, &nfc_configs,
+	       sizeof(struct platform_configs));
 	ret = configure_gpio(nfc_gpio->ven, GPIO_OUTPUT);
 	if (ret) {
 		pr_err("%s: unable to request nfc reset gpio [%d]\n", __func__,
@@ -325,20 +328,20 @@ int nfc_i2c_dev_probe(struct i2c_client *client, const struct i2c_device_id *id)
 		goto err_free_gpio;
 	}
 	client->irq = ret;
-	//ret = configure_gpio(nfc_gpio->mode_sw_nfcc, GPIO_OUTPUT);
-	//if (ret) {
-	//	pr_err
-	//		("%s: unable to request mode switch interface gpio [%d]\n",
-	//		 __func__, nfc_gpio->mode_sw_nfcc);
-	//	goto err_free_gpio;
-	//}
+	/* Default MODE high -> EMVCo; write /sys/class/nxp-nfc/nxpnfc/nfc_mode=0 for NFC Forum */
+	if (gpio_is_valid(nfc_gpio->mode_sw_nfcc)) {
+		/* Default: MODE low (NFC Forum). Only switch to EMVCo via nfc_mode sysfs write. */
+		ret = configure_gpio(nfc_gpio->mode_sw_nfcc, GPIO_OUTPUT);
+		if (ret) {
+			pr_err("%s: unable to request mode switch gpio [%d]\n",
+			       __func__, nfc_gpio->mode_sw_nfcc);
+			goto err_free_gpio;
+		}
+	}
 	#ifdef CONFIG_NXP_DEBUG_BOARD
 	/* configure board leds as OUTPUT gpios */
 	configure_leds(nfc_gpio);
 	#endif
-	/* copy the retrieved gpio details from DT */
-	memcpy(&nfc_dev->configs, &nfc_configs,
-		   sizeof(struct platform_configs));
 
 	/* init mutex and queues */
 	init_waitqueue_head(&nfc_dev->read_wq);
