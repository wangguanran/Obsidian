 			/* active state */
 			mux {
-				/* 69: Enable 31: Firmware */
+				/* 69: VEN/Enable */
 				pins = "gpio69";
 				function = "gpio";
 			};
@@ -16,7 +16,7 @@
 &nfc_enable_suspend {
 			/* sleep state */
 			mux {
-				/* 69: Enable 31: Firmware */
+				/* 69: VEN/Enable */
 				pins = "gpio69";
 				function = "gpio";
 			};
@@ -28,3 +28,34 @@
 			};
 };
 
+&tlmm {
+	nfc {
+		nfc_mode_active: nfc_mode_active {
+			mux {
+				/* 31: PN722x MODE (L=NFC Forum, H=EMVCo) */
+				pins = "gpio31";
+				function = "gpio";
+			};
+
+			config {
+				pins = "gpio31";
+				drive-strength = <2>; /* 2 MA */
+				bias-disable;
+				output-low;
+			};
+		};
+
+		nfc_mode_suspend: nfc_mode_suspend {
+			mux {
+				pins = "gpio31";
+				function = "gpio";
+			};
+
+			config {
+				pins = "gpio31";
+				drive-strength = <2>; /* 2 MA */
+				bias-disable;
+			};
+		};
+	};
+};
