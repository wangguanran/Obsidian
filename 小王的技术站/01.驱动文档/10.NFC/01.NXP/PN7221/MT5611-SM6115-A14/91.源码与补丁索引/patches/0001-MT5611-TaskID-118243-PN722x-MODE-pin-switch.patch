+/* MODE pin control: sysfs attribute name, write 0/1 to set Forum / EMVCo */
+#define NFC_MODE_CHAR_DEV_NAME		"nfc_mode"
 
 /* NCI packet details */
 #define NCI_CMD				(0x20)
@@ -136,7 +138,7 @@ enum gpio_values {
